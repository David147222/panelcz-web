# Panel Chmelnice - nastaveni pro Wedos (Apache)
RewriteEngine On
# www.panelcz.cz -> panelcz.cz a http -> https
# Pozor (Wedos): web lezi v podslozce domains/panelcz.cz, takze %{REQUEST_URI} obsahuje
# i "/domains/panelcz.cz/" a presmerovani vedlo na https://panelcz.cz/domains/panelcz.cz/...
# (zjisteno 9. 11. 2026). Cesta se proto bere ze zachycene casti adresy ($1), ktera je
# vuci teto slozce, a ne z %{REQUEST_URI}.
RewriteCond %{HTTP_HOST} ^www\. [NC,OR]
RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://panelcz.cz/$1 [L,R=301]
# Adresy, ktere uz takhle vznikly (zalozky, vyhledavace), vratit na cistou adresu
RewriteCond %{THE_REQUEST} \s/domains/panelcz\.cz/(\S*)\s [NC]
RewriteRule ^ https://panelcz.cz/%1 [L,R=301]
ErrorDocument 404 /index.html
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType text/css "access plus 30 days"
ExpiresByType application/javascript "access plus 30 days"
</IfModule>
<Files "oauth-config.php">
Require all denied
</Files>
# Zaloha stareho WordPressu neni verejne pristupna
RewriteRule ^_stary-web(/|$) - [F,L]
# Presmerovani starych adres puvodniho webu panelcz.cz (stav 3. 11. 2026)
RewriteRule ^ubytovani/informace-pro-ubytovane/?$ https://%{HTTP_HOST}/informace/ [R=301,L]
RewriteRule ^ubytovani/?$ https://%{HTTP_HOST}/apartmany/ [R=301,L]
RewriteRule ^tipy-na-vylety/?$ https://%{HTTP_HOST}/vylety/ [R=301,L]
RewriteRule ^areal/stanek/?$ https://%{HTTP_HOST}/bufet/ [R=301,L]
RewriteRule ^areal/zabavy/?$ https://%{HTTP_HOST}/hry/ [R=301,L]
RewriteRule ^areal/obchod/?$ https://%{HTTP_HOST}/obchod/ [R=301,L]
RewriteRule ^areal/pujcovna/?$ https://%{HTTP_HOST}/pujcovna/ [R=301,L]
RewriteRule ^sluzby-2/svatby/?$ https://%{HTTP_HOST}/svatby/ [R=301,L]
RewriteRule ^sluzby-2/?$ https://%{HTTP_HOST}/balicky/ [R=301,L]
RewriteRule ^wellness/bazen/?$ https://%{HTTP_HOST}/bazen/ [R=301,L]
RewriteRule ^wellness/finska-sauna/?$ https://%{HTTP_HOST}/sauna/ [R=301,L]
RewriteRule ^wellness/(masaze/?)?$ https://%{HTTP_HOST}/areal/ [R=301,L]
RewriteRule ^contact/?$ https://%{HTTP_HOST}/kontakt/ [R=301,L]
RewriteRule ^wp-(content|admin|includes)/ https://%{HTTP_HOST}/ [R=301,L]

# Fotky webu smí načíst i jiné weby (např. Previo při nahrávání galerií)
<IfModule mod_headers.c>
<FilesMatch "\.(jpe?g|png|webp)$">
Header set Access-Control-Allow-Origin "*"
</FilesMatch>
</IfModule>
