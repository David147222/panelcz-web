" height=\"90\" rx=\"4\" fill=\"#c98a4b\"/><rect x=\"541\" y=\"554\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><text x=\"520.0\" y=\"604.0\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#fff\">13</text><rect x=\"489\" y=\"672\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><rect x=\"503\" y=\"672\" width=\"34\" height=\"90\" rx=\"4\" fill=\"#c98a4b\"/><rect x=\"541\" y=\"672\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><text x=\"520.0\" y=\"722.0\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#fff\">14</text><rect x=\"589\" y=\"318\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><rect x=\"603\" y=\"318\" width=\"34\" height=\"90\" rx=\"4\" fill=\"#c98a4b\"/><rect x=\"641\" y=\"318\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><text x=\"620.0\" y=\"368.0\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#fff\">16</text><rect x=\"589\" y=\"436\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><rect x=\"603\" y=\"436\" width=\"34\" height=\"90\" rx=\"4\" fill=\"#c98a4b\"/><rect x=\"641\" y=\"436\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><text x=\"620.0\" y=\"486.0\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#fff\">17</text><rect x=\"589\" y=\"554\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><rect x=\"603\" y=\"554\" width=\"34\" height=\"90\" rx=\"4\" fill=\"#c98a4b\"/><rect x=\"641\" y=\"554\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><text x=\"620.0\" y=\"604.0\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#fff\">18</text><rect x=\"589\" y=\"672\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><rect x=\"603\" y=\"672\" width=\"34\" height=\"90\" rx=\"4\" fill=\"#c98a4b\"/><rect x=\"641\" y=\"672\" width=\"10\" height=\"90\" rx=\"3\" fill=\"#8a5426\"/><text x=\"620.0\" y=\"722.0\" text-anchor=\"middle\" font-size=\"14\" font-weight=\"700\" fill=\"#fff\">15</text><text x=\"520\" y=\"815\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"#16505e\">B · 14 Tische in 3 Reihen</text><text x=\"520\" y=\"835\" text-anchor=\"middle\" font-size=\"12\" fill=\"#5a6e72\">1 Tisch = 2 Bänke à 4 Personen · 18 Tische = 144 Plätze</text><path d=\"M300 960 L300 924\" stroke=\"#16505e\" stroke-width=\"3\" marker-end=\"url(#a)\"/><text x=\"312\" y=\"946\" font-size=\"13\" fill=\"#16505e\">Zugang vom Pool</text></svg><div class=\"tw\" style=\"margin-top:16px\"><table><thead><tr><th>Bereich</th><th>Tische</th><th>Sitzplätze</th><th>Hinweis</th></tr></thead><tbody><tr><td><b>Terrasse A</b> (am Gebäude)</td><td>4 Tische, 2 Reihen à 2</td><td>32</td><td>fest verschraubt</td></tr><tr><td><b>Terrasse B</b> (3 Reihen zur Bühne)</td><td>14 Tische (5 + 5 + 4)</td><td>112</td><td>fest verschraubt, Reihe am Geländer mit Blick auf den Stausee</td></tr><tr><td><b>Tanzfläche an der Bühne</b></td><td>lose Tische und Stühle</td><td>nach Bedarf</td><td>ganz oder nur teilweise, der Rest zum Tanzen</td></tr><tr><td><b>Gemeinschaftsraum</b></td><td>4 Tische</td><td>ca. 30</td><td>Kamin, Bar mit Zapfanlage, grenzt an die Terrasse</td></tr><tr><td><b>Gesamt</b></td><td>18 Tische auf der Terrasse</td><td><b>144 + ca. 30</b></td><td>Unterkunft für 37 Gäste</td></tr></tbody></table></div><p style=\"color:var(--muted);font-size:.92rem;margin-top:10px\">Alle Tische sind gleich: zu jedem gehören 2 Bänke, auf jeder sitzen bequem 4 Personen.</p><div class=\"two\" style=\"margin-top:40px\"><div><h2 style=\"font-size:1.6rem;margin-bottom:12px\">Beispiel-Ablaufplan</h2><p style=\"color:var(--muted);margin:0 0 10px\">Paket Hochzeit im Panel, Trauung am Samstag</p><ul class=\"tl\"><li><b>Do 10:00</b><span>Vorbereitungstag (gegen Aufpreis): Dekoration der Terrasse, Tische auf die Tanzfläche, Probe der Trauung</span></li><li><b>Fr 15:00</b><span>Anreise und Unterbringung der Hochzeitsgäste, abends Grillen an der Feuerstelle</span></li><li><b>Sa 9:00</b><span>Vorbereitung von Braut und Bräutigam in den Apartments, Fotograf</span></li><li><b>Sa 13:00</b><span>Trauung auf der Bühne oder am Stausee</span></li><li><b>Sa 14:00</b><span>Glückwünsche, Sektempfang, Gruppenfotos am Wasser</span></li><li><b>Sa 15:00</b><span>Hochzeitsessen auf der Terrasse</span></li><li><b>Sa 17:00</b><span>Anschneiden der Torte, freie Unterhaltung, Sauna und Whirlpool für das Brautpaar</span></li><li><b>Sa 19:00</b><span>Abendbuffet und Eröffnungstanz, Band oder DJ auf der Bühne</span></li><li><b>Sa 22:00</b><span>Die Musik wird leiser, die Feier geht im Gemeinschaftsraum am Kamin weiter</span></li><li><b>Sa 24:00</b><span>Nachtruhe</span></li><li><b>So 10:00</b><span>Gemeinsames Frühstück</span></li><li><b>So 14:00</b><span>Abreise (späte Abreise gratis)</span></li></ul></div><div><h2 style=\"font-size:1.6rem;margin-bottom:12px\">Empfohlene Dienstleister</h2><p style=\"color:var(--muted);margin:0 0 10px\">Mit diesen Dienstleistern haben wir gute Erfahrungen gemacht und sie kennen unsere Anlage.</p><div style=\"display:grid;gap:10px\"><div class=\"box\" style=\"padding:14px 16px\"><span class=\"w\" style=\"font-size:.75rem;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:var(--lake2)\">Catering</span><h3 style=\"font-size:1.05rem;margin:2px 0\">Catering Grasel</h3><p style=\"margin:0;color:var(--muted);font-size:.92rem\">Hochzeitsmenü, Buffet und Grillen · <a href=\"https://catering-grasel.cz\" target=\"_blank\" rel=\"noopener\">catering-grasel.cz</a></p></div></div></div></div></div></section><section><div class=\"in\"><div class=\"head\"><span class=\"ey\">Extras zur Hochzeit</span><h2>Vorbereitungstag, Catering und Getränke</h2><p>Alles, was Sie zur Hochzeit dazubuchen können. Die Preise gelten für die ganze Veranstaltung.</p></div>\n<div class=\"pks\">\n<div class=\"pk\"><span class=\"w\">Vorbereitungstag</span><h3>Ein Tag vorher mit Übernachtung</h3><div class=\"pc\" style=\"font-size:1.2rem\">buchbar bei der Reservierung</div><div class=\"pn\">Nacht Donnerstag → Freitag</div><ul class=\"ck\"><li>Die Anlage gehört Ihnen ab Donnerstag 15:00</li><li>Dekoration, Tische und Probe der Trauung in Ruhe am Vortag</li><li>Familie und Trauzeugen übernachten vor Ort</li><li>Räume ab Donnerstag und Übernachtung für Familie und Trauzeugen</li></ul></div>\n<div class=\"pk\"><span class=\"w\">Vorbereitungstag</span><h3>Nur Räume zur Vorbereitung</h3><div class=\"pc\" style=\"font-size:1.2rem\">buchbar bei der Reservierung</div><div class=\"pn\">Donnerstag 10:00 – 20:00, ohne Übernachtung</div><ul class=\"ck\"><li>Terrasse und Gemeinschaftsraum zum Dekorieren</li><li>Anlieferung und Lagerung von Dingen für die Hochzeit</li><li>Abends fahren Sie weg und checken am Freitag ein</li></ul></div>\n<div class=\"pk\"><span class=\"w\">Bonus</span><h3>Späte Abreise</h3><div class=\"pc\">gratis</div><div class=\"pn\">am Abreisetag bis 14:00</div><ul class=\"ck\"><li>Nach der Hochzeit keine Eile</li><li>In allen Hochzeitspaketen enthalten</li></ul></div>\n<div class=\"pk top\"><span class=\"badge\">Unsere Empfehlung</span><span class=\"w\">Catering</span><h3>Hochzeitscatering von uns</h3><div class=\"pc\" style=\"font-size:1.2rem\">auf Anfrage</div><div class=\"pn\">den Preis senden wir je nach gewähltem Menü</div><ul class=\"ck\"><li>Wir bereiten es in unserer Küche zu (Catering Grasel)</li><li>Hochzeitsmenü, Buffet, Grillen auf der Terrasse</li><li>Service und Abwasch inklusive</li><li>Externes Catering gegen Gebühr möglich (buchbar bei der Reservierung)</li></ul></div>\n<div class=\"pk\"><span class=\"w\">Getränke</span><h3>Bier und Limonade vom Fass</h3><div class=\"pc\" style=\"font-size:1.2rem\">auf Anfrage</div><div class=\"pn\">das aktuelle Angebot an Bier- und Limonadenfässern senden wir Ihnen</div><ul class=\"ck\"><li>Sie zapfen selbst am Kiosk oder im Gemeinschaftsraum</li><li>Fässer liefern nur wir, angebrochene werden nicht zurückgenommen</li><li>Eigener Wein und Spirituosen ohne Gebühr</li></ul></div>\n</div></div></section><section class=\"alt\"><div class=\"in split\"><div class=\"prose\"><span class=\"ey\">Ruhe und Lage</span><h2>Unter Cornštejn, nah am Wasser</h2><p>Panelcz steht in der Erholungssiedlung Chmelnice am Ufer des Stausees Vranov, unterhalb der Burgruine Cornštejn. Außerhalb der Sommersaison ist es hier ruhig: kein Verkehr, nur Wald, Wasser und Ihre Gruppe. Eine laute Feier stört hier niemanden, und trotzdem sind Sie in 35 Minuten in Znojmo.</p><ul class=\"ck\"><li>Sandstrand ca. 100 m von der Anlage</li><li>Burgruine Cornštejn und Burg Bítov in Sichtweite</li><li>Eingezäunte Anlage, Parkplatz für 10 Autos direkt daneben</li><li>Umgebung des Nationalparks Podyjí</li></ul><p style=\"margin-top:16px\"><a href=\"/de/jak-k-nam/\">Anfahrt →</a></p></div><div><iframe class=\"map\" loading=\"lazy\" title=\"Karte – Panelcz\" src=\"https://www.openstreetmap.org/export/embed.html?bbox=15.66%2C48.91%2C15.76%2C48.955&layer=mapnik&marker=48.9328522%2C15.7103475\"></iframe></div></div></section><section><div class=\"in\"><div class=\"gal\"><div style=\"background-image:url('{{foto:sv_obrad}}')\"></div><div style=\"background-image:url('{{foto:sv_hlavni}}')\"></div><div style=\"background-image:url('{{foto:sv_pano}}')\"></div><div style=\"background-image:url('{{foto:sv_stoly}}')\"></div><div style=\"background-image:url('{{foto:terasa1}}')\"></div><div style=\"background-image:url('{{foto:podium}}')\"></div></div></div></section><section class=\"cta\" style=\"background-image:url('{{foto:dvur}}')\"><div class=\"in\"><span class=\"ey\" style=\"color:#ffd3a8\">Nicht vergessen</span><h2>Vereinbaren Sie eine Besichtigung</h2><p>Wir zeigen Ihnen gern die Anlage und besprechen Ihre Vorstellungen.</p><a class=\"btn\" href=\"/de/kontakt/\">Besichtigung vereinbaren</a></div></section>"
